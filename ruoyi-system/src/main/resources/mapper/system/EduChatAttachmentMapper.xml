<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduChatAttachmentMapper">
    <resultMap id="AttachmentResult" type="com.ruoyi.system.domain.EduChatAttachment">
        <id property="id" column="id"/><result property="userId" column="user_id"/>
        <result property="sessionId" column="session_id"/><result property="originalName" column="original_name"/>
        <result property="storagePath" column="storage_path"/><result property="fileSize" column="file_size"/>
        <result property="mimeType" column="mime_type"/><result property="extension" column="extension"/>
        <result property="contentStatus" column="content_status"/><result property="extractedText" column="extracted_text"/>
        <result property="errorMessage" column="error_message"/><result property="createTime" column="create_time"/>
    </resultMap>
    <insert id="insert" parameterType="com.ruoyi.system.domain.EduChatAttachment" useGeneratedKeys="true" keyProperty="id">
        insert into edu_chat_attachment (user_id,session_id,original_name,storage_path,file_size,mime_type,extension,content_status,extracted_text,error_message,create_time)
        values (#{userId},#{sessionId},#{originalName},#{storagePath},#{fileSize},#{mimeType},#{extension},#{contentStatus},#{extractedText},#{errorMessage},sysdate())
    </insert>
    <select id="selectByIdAndUserId" resultMap="AttachmentResult">select * from edu_chat_attachment where id=#{id} and user_id=#{userId}</select>
    <select id="selectByIdsAndUserId" resultMap="AttachmentResult">
        select * from edu_chat_attachment where user_id=#{userId} and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <select id="selectBySessionAndUserId" resultMap="AttachmentResult">select * from edu_chat_attachment where session_id=#{sessionId} and user_id=#{userId}</select>
    <delete id="deleteByIdAndUserId">delete from edu_chat_attachment where id=#{id} and user_id=#{userId}</delete>
</mapper>
