<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysAttachmentMapper">

    <resultMap type="SysAttachment" id="SysAttachmentResult">
        <result property="id"           column="id"            />
        <result property="fileName"     column="file_name"     />
        <result property="filePath"     column="file_path"     />
        <result property="fileSize"     column="file_size"     />
        <result property="mimeType"     column="mime_type"     />
        <result property="extension"    column="extension"     />
        <result property="entityType"   column="entity_type"   />
        <result property="entityId"     column="entity_id"     />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
    </resultMap>

    <sql id="selectAttachmentVo">
        select id, file_name, file_path, file_size, mime_type, extension,
               entity_type, entity_id, create_by, create_time
        from sys_attachment
    </sql>

    <select id="selectAttachmentById" parameterType="Long" resultMap="SysAttachmentResult">
        <include refid="selectAttachmentVo"/>
        where id = #{id}
    </select>

    <select id="selectAttachmentList" parameterType="SysAttachment" resultMap="SysAttachmentResult">
        <include refid="selectAttachmentVo"/>
        <where>
            <if test="fileName != null and fileName != ''">
                AND file_name like concat('%', #{fileName}, '%')
            </if>
            <if test="extension != null and extension != ''">
                AND extension = #{extension}
            </if>
            <if test="entityType != null and entityType != ''">
                AND entity_type = #{entityType}
            </if>
            <if test="createBy != null and createBy != ''">
                AND create_by like concat('%', #{createBy}, '%')
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by id desc
    </select>

    <insert id="insertAttachment" parameterType="SysAttachment" useGeneratedKeys="true" keyProperty="id">
        insert into sys_attachment (
            <if test="fileName != null and fileName != ''">file_name,</if>
            <if test="filePath != null and filePath != ''">file_path,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="mimeType != null">mime_type,</if>
            <if test="extension != null">extension,</if>
            <if test="entityType != null">entity_type,</if>
            <if test="entityId != null">entity_id,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        ) values (
            <if test="fileName != null and fileName != ''">#{fileName},</if>
            <if test="filePath != null and filePath != ''">#{filePath},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="mimeType != null">#{mimeType},</if>
            <if test="extension != null">#{extension},</if>
            <if test="entityType != null">#{entityType},</if>
            <if test="entityId != null">#{entityId},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        )
    </insert>

    <delete id="deleteAttachmentByIds">
        delete from sys_attachment where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
