<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.QuizQuestionMapper">

    <resultMap type="QuizQuestion" id="QuizQuestionResult">
        <id     property="id"              column="id"               />
        <result property="questionType"    column="question_type"    />
        <result property="stem"            column="stem"             />
        <result property="options"         column="options"          />
        <result property="answer"          column="answer"           />
        <result property="explanation"     column="explanation"      />
        <result property="difficulty"      column="difficulty"       />
        <result property="knowledgePoints" column="knowledge_points" />
        <result property="source"          column="source"           />
        <result property="correctRate"     column="correct_rate"     />
        <result property="status"          column="status"           />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateTime"      column="update_time"      />
    </resultMap>

    <!-- Deliberately separate from QuizQuestionResult: learner endpoints must
         never select or serialize answer/explanation before submission. -->
    <resultMap type="com.ruoyi.system.domain.StudentQuizQuestion" id="StudentQuizQuestionResult">
        <id     property="id"              column="id"               />
        <result property="questionType"    column="question_type"    />
        <result property="stem"            column="stem"             />
        <result property="options"         column="options"          />
        <result property="difficulty"      column="difficulty"       />
        <result property="knowledgePoints" column="knowledge_points" />
    </resultMap>

    <sql id="selectQuestionVo">
        select id, question_type, stem, options, answer, explanation,
               difficulty, knowledge_points, source, correct_rate, status,
               create_by, create_time, update_time
        from quiz_question
    </sql>

    <sql id="selectStudentQuestionVo">
        select q.id, q.question_type, q.stem, q.options, q.difficulty, q.knowledge_points
        from quiz_question q
    </sql>

    <sql id="studentQuestionFilters">
        where q.status = '0'
        <if test="query.keyword != null and query.keyword != ''">
            and q.stem like concat('%', #{query.keyword}, '%')
        </if>
        <if test="query.questionType != null and query.questionType != ''">
            and q.question_type = #{query.questionType}
        </if>
        <if test="query.difficulty != null and query.difficulty != ''">
            and q.difficulty = #{query.difficulty}
        </if>
        <if test="query.knowledgePoint != null and query.knowledgePoint != ''">
            and JSON_CONTAINS(q.knowledge_points, JSON_QUOTE(#{query.knowledgePoint}))
        </if>
    </sql>

    <!-- 插入一道题目 -->
    <insert id="insertQuestion" parameterType="QuizQuestion" useGeneratedKeys="true" keyProperty="id">
        insert into quiz_question (
            question_type,
            stem,
            <if test="options != null">options,</if>
            answer,
            <if test="explanation != null">explanation,</if>
            difficulty,
            <if test="knowledgePoints != null">knowledge_points,</if>
            source,
            status,
            create_by,
            create_time,
            update_time
        ) values (
            #{questionType},
            #{stem},
            <if test="options != null">#{options},</if>
            #{answer},
            <if test="explanation != null">#{explanation},</if>
            #{difficulty},
            <if test="knowledgePoints != null">#{knowledgePoints},</if>
            #{source},
            #{status},
            #{createBy},
            sysdate(),
            sysdate()
        )
    </insert>

    <!-- 按难度查询题目（状态启用） -->
    <select id="selectByDifficulty" resultMap="QuizQuestionResult">
        <include refid="selectQuestionVo"/>
        where status = '0'
        <if test="difficulty != null and difficulty != ''">
            and difficulty = #{difficulty}
        </if>
        order by create_time desc
        limit #{limit}
    </select>

    <!-- 按 ID 查询 -->
    <select id="selectQuestionById" parameterType="Long" resultMap="QuizQuestionResult">
        <include refid="selectQuestionVo"/>
        where id = #{id}
    </select>

    <!-- 更新题目正确率 -->
    <update id="updateCorrectRate">
        update quiz_question
        set correct_rate = #{correctRate},
            update_time = sysdate()
        where id = #{id}
    </update>

    <select id="selectStudentQuestions" resultMap="StudentQuizQuestionResult">
        <include refid="selectStudentQuestionVo"/>
        <include refid="studentQuestionFilters"/>
        order by q.id desc
        limit #{query.offset}, #{query.pageSize}
    </select>

    <select id="countStudentQuestions" resultType="long">
        select count(1) from quiz_question q
        <include refid="studentQuestionFilters"/>
    </select>

    <select id="selectStudentQuestionById" parameterType="Long" resultMap="StudentQuizQuestionResult">
        <include refid="selectStudentQuestionVo"/>
        where q.id = #{id} and q.status = '0'
    </select>

    <select id="selectStudentQuestionByIdIncludingDisabled" parameterType="Long" resultMap="StudentQuizQuestionResult">
        <include refid="selectStudentQuestionVo"/>
        where q.id = #{id}
    </select>

    <select id="selectStudentQuestionTypes" resultType="String">
        select distinct question_type from quiz_question
        where status = '0' and question_type is not null and question_type != ''
        order by question_type
    </select>

    <select id="selectStudentDifficulties" resultType="String">
        select distinct difficulty from quiz_question
        where status = '0' and difficulty is not null and difficulty != ''
        order by field(difficulty, 'easy', 'medium', 'hard'), difficulty
    </select>

    <select id="selectStudentKnowledgePointJsons" resultType="String">
        select knowledge_points from quiz_question
        where status = '0' and knowledge_points is not null
    </select>

</mapper>
