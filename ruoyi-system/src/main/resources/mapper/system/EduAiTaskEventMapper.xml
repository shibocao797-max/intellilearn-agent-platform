<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduAiTaskEventMapper">
    <resultMap id="EventResult" type="com.ruoyi.system.domain.EduAiTaskEvent">
        <id property="sequence" column="sequence"/>
        <result property="taskId" column="task_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="eventType" column="event_type"/>
        <result property="agentKey" column="agent_key"/>
        <result property="status" column="status"/>
        <result property="payloadJson" column="payload_json"/>
        <result property="occurredTime" column="occurred_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.ruoyi.system.domain.EduAiTaskEvent"
            useGeneratedKeys="true" keyProperty="sequence" keyColumn="sequence">
        insert into edu_ai_task_event
        (task_id,session_id,event_type,agent_key,status,payload_json,occurred_time)
        values
        (#{taskId},#{sessionId},#{eventType},#{agentKey},#{status},#{payloadJson},CURRENT_TIMESTAMP(3))
    </insert>

    <select id="selectAfter" resultMap="EventResult">
        select sequence,task_id,session_id,event_type,agent_key,status,payload_json,occurred_time
        from edu_ai_task_event
        where task_id=#{taskId} and sequence &gt; #{afterSeq}
        order by sequence asc
    </select>
</mapper>
